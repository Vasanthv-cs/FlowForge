# ==============================================================================
# FlowForge Environment Configuration Template (v1.0.0-rc1)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets/keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC CONFIGURATION (Vite Client Bundle)
# ------------------------------------------------------------------------------
# Baked into static JavaScript assets during build. Accessible in the browser.
# NEVER put private API secrets, database passwords, or service-role keys here.
#
VITE_SUPABASE_URL=https://rnkaowxaaxdzumliicku.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER-ONLY CONFIGURATION (Fastify Node.js Service)
# ------------------------------------------------------------------------------
# Used exclusively by the Fastify backend and durable worker pool.
#
# Process binding & environment:
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Supabase Server Connectivity:
SUPABASE_URL=https://rnkaowxaaxdzumliicku.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Cross-Origin Resource Sharing (CORS):
# In development: http://localhost:5173
# In production: must be explicitly configured (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting & Body Limits:
RATE_LIMIT_MAX=100
BODY_LIMIT=1048576

# Security & TLS Enforcement (set to true behind SSL reverse proxies in production):
ENFORCE_HTTPS=false

# ------------------------------------------------------------------------------
# 3. CREDENTIAL VAULT ENCRYPTION MASTER KEY (AES-256-GCM)
# ------------------------------------------------------------------------------
# Must be exactly 32 bytes (64 hex characters or 32 raw bytes).
# NEVER prefix with VITE_ and NEVER commit real keys.
# Generate a new 64-character hex key via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLOWFORGE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. DURABLE WORKER & SCHEDULER POOL CONFIGURATION
# ------------------------------------------------------------------------------
# Controls concurrency limits, polling intervals, and recovery sweeps.
#
WORKER_MAX_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
SCHEDULER_POLL_INTERVAL_MS=5000

# ------------------------------------------------------------------------------
# 5. CLI ENVIRONMENT OVERRIDES (Optional)
# ------------------------------------------------------------------------------
# Default endpoints and workspace targeting when using `flowforge` CLI.
#
# FLOWFORGE_API_URL=http://localhost:3001
# FLOWFORGE_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
