# ==============================================================================
# FlowForge MVP Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC CONFIGURATION (Vite Client Bundle)
# ------------------------------------------------------------------------------
# These variables are baked into static JavaScript assets during build.
# NEVER put private API secrets, database passwords, or service-role keys here.
#
VITE_SUPABASE_URL=https://rnkaowxaaxdzumliicku.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER-ONLY CONFIGURATION (Fastify Node.js Service)
# ------------------------------------------------------------------------------
# Used exclusively on the backend server. Must NOT have VITE_ prefix.
#
# Process binding & environment:
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Supabase Server Connectivity:
SUPABASE_URL=https://rnkaowxaaxdzumliicku.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Cross-Origin Resource Sharing (CORS):
# In development: http://localhost:5173
# In production: must be explicitly configured with production domain(s)
# Supports comma-separated list e.g. https://flowforge.app,https://admin.flowforge.app
CORS_ORIGIN=http://localhost:5173

# Rate Limiting & Body Limits:
RATE_LIMIT_MAX=100
BODY_LIMIT=1048576

# Security & TLS Enforcement:
# Set to true in production or behind SSL reverse proxy / Cloudflare / Render:
ENFORCE_HTTPS=false
