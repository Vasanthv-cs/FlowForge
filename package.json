{
  "name": "flowforge",
  "private": true,
  "version": "1.0.0-rc1",
  "description": "Visual Workflow Programming Studio and Distributed Automation Platform built with React 19, Fastify, Supabase PostgreSQL, and strict TypeScript.",
  "keywords": [
    "workflow",
    "automation",
    "dag",
    "visual-programming",
    "react-flow",
    "xyflow",
    "fastify",
    "supabase",
    "durable-execution",
    "orchestration"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "server": "tsx src/server/index.ts",
    "server:dev": "tsx watch src/server/index.ts",
    "cli": "tsx packages/cli/src/index.ts",
    "smoke-test": "tsx scripts/smokeTest.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "bin": {
    "flowforge": "./packages/cli/bin/flowforge.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/supabase-js": "^2.119.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
