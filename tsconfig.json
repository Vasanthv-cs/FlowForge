{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@flowforge/workflow-schema": ["./packages/workflow-schema/src/index.ts"],
      "@flowforge/node-sdk": ["./packages/node-sdk/src/index.ts"],
      "@flowforge/shared": ["./packages/shared/src/index.ts"],
      "@flowforge/workflow-core": ["./packages/workflow-core/src/index.ts"]
    }
  },
  "include": ["src", "packages"]
}
